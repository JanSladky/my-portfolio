{
  "kind": "collectionType",
  "collectionName": "references",
  "info": {
    "singularName": "reference",
    "pluralName": "references",
    "displayName": "Reference"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "web",
      "enum": [
        "web",
        "app"
      ]
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "text"
    },
    "demo_url": {
      "type": "string",
      "regex": "^https?:\\/\\/.+$"
    },
    "repo_url": {
      "type": "string",
      "regex": "^https?:\\/\\/.+$"
    }
  }
}
